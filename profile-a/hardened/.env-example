PORT=8080
APP_BASE_URL=https://app-a.local
KEYCLOAK_ISSUER_HOST=keycloak.local
KEYCLOAK_INTERNAL_HOST=keycloak
KEYCLOAK_PORT=8080
PROFILE_A_REALM=profile-a-hardened
PROFILE_A_CLIENT_ID=sso-test-app
PROFILE_A_CLIENT_SECRET=Str0ngCl!entS3cr3t_changeme
APP_DATABASE_URL=postgres://keycloak:keycloak@postgres:5432/keycloak?sslmode=disable
WEBAUTHN_RP_ID=app-a.local
WEBAUTHN_RP_ORIGINS=https://app-a.local
WEBAUTHN_USER_ID=testuser@example.com
LOCAL_LOGIN_USERNAME=testuser@example.com
LOCAL_LOGIN_PASSWORD=testpass123
SESSION_SECRET=hardened-64-char-random-secret-replace-in-production-please-xx
# Hardened cookie flags — HttpOnly, Secure, SameSite=Strict
SESSION_HTTPONLY=true
SESSION_SECURE=true
SESSION_SAMESITE=strict
# Security headers enabled in hardened mode
SECURITY_HEADERS=true
# PKCE S256 required in hardened mode
PKCE_ENABLED=true

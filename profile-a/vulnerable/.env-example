PORT=8080
APP_BASE_URL=http://app-a.local:8081
KEYCLOAK_ISSUER_HOST=keycloak.local
KEYCLOAK_INTERNAL_HOST=keycloak
KEYCLOAK_PORT=8080
PROFILE_A_REALM=profile-a-vulnerable
PROFILE_A_CLIENT_ID=sso-test-app
PROFILE_A_CLIENT_SECRET=testpass123
APP_DATABASE_URL=postgres://keycloak:keycloak@postgres:5432/keycloak?sslmode=disable
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://app-a.local:8081
WEBAUTHN_USER_ID=testuser@example.com
LOCAL_LOGIN_USERNAME=testuser@example.com
LOCAL_LOGIN_PASSWORD=testpass123
SESSION_SECRET=vulnerable-not-secret-at-all
# Vulnerable cookie flags — no HttpOnly, no Secure, no SameSite
SESSION_HTTPONLY=false
SESSION_SECURE=false
SESSION_SAMESITE=none
# No security headers in vulnerable mode
SECURITY_HEADERS=false
# No PKCE enforcement in vulnerable mode
PKCE_ENABLED=false

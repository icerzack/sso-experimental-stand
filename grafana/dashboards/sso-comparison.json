{
  "dashboard": {
    "title": "SAML vs OIDC Comparison",
    "tags": ["sso", "saml", "oidc"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Login Duration (SAML vs OIDC)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(sso_login_duration_seconds_bucket{service=\"saml-sp\"}[5m]))",
            "legendFormat": "SAML p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(sso_login_duration_seconds_bucket{service=\"oidc-rp\"}[5m]))",
            "legendFormat": "OIDC p95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(sso_login_errors_total{service=\"saml-sp\"}[5m]) / rate(sso_login_attempts_total{service=\"saml-sp\"}[5m]) * 100",
            "legendFormat": "SAML Error Rate",
            "refId": "A"
          },
          {
            "expr": "rate(sso_login_errors_total{service=\"oidc-rp\"}[5m]) / rate(sso_login_attempts_total{service=\"oidc-rp\"}[5m]) * 100",
            "legendFormat": "OIDC Error Rate",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Error Rate %"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Redirect Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(sso_redirect_count_bucket{service=\"saml-sp\"}[5m]))",
            "legendFormat": "SAML p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(sso_redirect_count_bucket{service=\"oidc-rp\"}[5m]))",
            "legendFormat": "OIDC p95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Redirects"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Active Sessions",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sso_active_sessions{service=\"saml-sp\"}",
            "legendFormat": "SAML Sessions",
            "refId": "A"
          },
          {
            "expr": "sso_active_sessions{service=\"oidc-rp\"}",
            "legendFormat": "OIDC Sessions",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Sessions"},
          {"format": "short"}
        ]
      }
    ]
  }
}


{
  "dashboard": {
    "title": "Authentication Profile Comparison",
    "tags": ["sso", "authentication", "profiles"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Login Duration by Profile",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(sso_login_duration_seconds_bucket{service=\"app\"}[5m])))",
            "legendFormat": "{{profile}} p95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Error Rate by Profile",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum by (profile) (rate(sso_login_errors_total{service=\"app\"}[5m])) / sum by (profile) (rate(sso_login_attempts_total{service=\"app\"}[5m])) * 100",
            "legendFormat": "{{profile}} error rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Error Rate %"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Redirect Count by Profile",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(sso_redirect_count_bucket{service=\"app\"}[5m])))",
            "legendFormat": "{{profile}} p95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Redirects"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Active Sessions by Profile",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sso_active_sessions{service=\"app\"}",
            "legendFormat": "{{profile}} sessions",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Sessions"},
          {"format": "short"}
        ]
      }
    ]
  }
}

# PostgreSQL Configuration
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_HOST=keycloak.localhost
KEYCLOAK_PORT=8080
PROFILE_A_REALM=profile-a
PROFILE_A_CLIENT_ID=sso-test-app
PROFILE_A_CLIENT_SECRET=profile-a-secret

# Service Ports
APP_HOST_PORT=8081
VAULTWARDEN_PORT=8083

# Test Application
APP_BASE_URL=http://app.localhost
APP_DATABASE_URL=postgres://keycloak:keycloak@postgres:5432/keycloak?sslmode=disable
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:8081,https://localhost:8443
WEBAUTHN_USER_ID=passkey-user
WEBAUTHN_APP_BASE_URL=http://localhost:8081
LOCAL_LOGIN_USERNAME=testuser1
LOCAL_LOGIN_PASSWORD=password123

# Vaultwarden Configuration
VAULTWARDEN_DOMAIN=https://vaultwarden.localhost
VAULTWARDEN_SIGNUPS_ALLOWED=true
VAULTWARDEN_ADMIN_TOKEN=dev-admin-token
VAULTWARDEN_URL=https://vaultwarden.localhost
VAULTWARDEN_EMAIL=testuser1@example.com
VAULTWARDEN_MASTER_PASSWORD=password123
VAULTWARDEN_ITEM_NAME=app.localhost
VAULTWARDEN_ALLOW_REGISTER=0
VAULTWARDEN_FALLBACK_CREDENTIALS=1
SKIP_VAULTWARDEN_SETUP=0

# Session Security
SESSION_SECRET=change-me-in-production-use-strong-random-string

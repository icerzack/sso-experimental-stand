# ── SSO Experimental Stand — Environment Variables ──
# Copy this file to .env and adjust values as needed.
# Defaults are set for local development with self-signed certs.

# ── General ──
AUTH_MODE=oidc                   # oidc | saml | forward_auth
HARDENED=false                  # true enables security hardening (Experiment 1)

# ── Application ──
APP_BASE_URL=https://app.sso-lab.local

# ── Identity Provider ──
IDP_ISSUER_HOST=idp.sso-lab.local
IDP_INTERNAL_HOST=idp            # Docker network hostname
IDP_PORT=8080                    # Internal port (9000 for Authentik, 8080 for Keycloak)
IDP_EXTERNAL_URL=                # Full external OIDC issuer URL (auto-derived if empty)
OIDC_REALM=sso-lab               # Keycloak realm name (unused for Authentik)
IDP_SCHEME=https

# ── OIDC Client ──
CLIENT_ID=sso-test-app
CLIENT_SECRET=testpass123

# ── Session / Security ──
SESSION_SECRET=insecure-key       # Change for production!
REMOTE_USER_HEADER=X-Remote-User
ALLOWED_REDIRECT_DOMAIN=app.sso-lab.local

# ── Database ──
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

# ── Authentik-specific (E2B profile) ──
AUTHENTIK_SECRET_KEY=changeme_insecure_secret_key_32chars  # Must be ≥30 chars

# ── Load Testing ──
TARGET_VU=10                      # k6 target virtual users
HOLD_DURATION=60s                 # Steady-state duration

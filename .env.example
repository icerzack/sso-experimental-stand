# PostgreSQL Configuration
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=sso-test

# Service Ports
SAML_SP_PORT=8081
OIDC_RP_PORT=8082

# OIDC Client Configuration
OIDC_CLIENT_ID=oidc-rp-client
OIDC_CLIENT_SECRET=change-me

# Session Security
SESSION_SECRET=change-me-in-production-use-strong-random-string

# Keycloak Issuer Host (must match KC_HOSTNAME in Keycloak)
KEYCLOAK_ISSUER_HOST=keycloak

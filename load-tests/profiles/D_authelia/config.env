# ============================================================================
# Profile D — Authelia OIDC Configuration
# ============================================================================
# This file is sourced by shared/run-load-test.sh and run-full-benchmark.sh
# ============================================================================

BASE_URL="https://idp.sso-lab.local"
APP_URL="https://app.sso-lab.local"
CONTAINER_NAME="sso-lab-idp"
CLIENT_ID="sso-test-app"
CLIENT_SECRET="testpass123"
TEST_USER="alice"
TEST_PASSWORD="password1"

# Authelia endpoints (different from Keycloak/Authentik)
TOKEN_URL="https://idp.sso-lab.local/api/oidc/token"
AUTH_URL="https://idp.sso-lab.local/api/oidc/authorization"
WELL_KNOWN="https://idp.sso-lab.local/.well-known/openid-configuration"

# For startup measurement — direct token request won't work with Authelia's
# browser-based flow, so we use the well-known endpoint as a liveness check.
# The full first-login time is measured separately via k6 single-VU run.
TOKEN_POST=""

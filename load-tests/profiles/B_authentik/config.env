BASE_URL="https://idp.sso-lab.local"
APP_URL="https://app.sso-lab.local"
CONTAINER_NAME="sso-lab-idp"
CLIENT_ID="sso-test-app"
CLIENT_SECRET="testpass123"
TEST_USER="testuser"
TEST_PASSWORD="testpass123"

# Authentik uses different endpoint paths than Keycloak
TOKEN_URL="https://idp.sso-lab.local/application/o/token/"
AUTH_URL="https://idp.sso-lab.local/application/o/authorize/"
WELL_KNOWN="https://idp.sso-lab.local/application/o/sso-test-app/.well-known/openid-configuration"

# For startup measurement — client_credentials grant
TOKEN_POST="grant_type=client_credentials&client_id=sso-test-app&client_secret=testpass123&scope=openid+profile+email"

# k6 test script (relative to profile directory)
K6_SCRIPT="oidc-login.js"

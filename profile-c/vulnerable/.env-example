# Vaultwarden — Vulnerable configuration
# Accessible at http://app-c.local:8083

DOMAIN=http://app-c.local:8083

# VULNERABLE A1/A2: registrations open, rate limits disabled
SIGNUPS_ALLOWED=true
LOGIN_RATELIMIT_MAX_BURST=1000
LOGIN_RATELIMIT_SECONDS=1
ADMIN_RATELIMIT_MAX_BURST=1000
ADMIN_RATELIMIT_SECONDS=1

# VULNERABLE: admin panel exposed with a weak token
ADMIN_TOKEN=admin

# VULNERABLE: no HTTPS, no HSTS
ROCKET_TLS=

# VULNERABLE: long session lifetime
SESSION_JWT_EXPIRATION=10080

WEBSOCKET_ENABLED=true
LOG_LEVEL=warn

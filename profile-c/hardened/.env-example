# Vaultwarden — Hardened configuration
# Accessible at https://app-c.local (via Nginx reverse proxy)

DOMAIN=https://app-c.local

# HARDENED A1/A2: registrations closed, strict rate limits
SIGNUPS_ALLOWED=false
LOGIN_RATELIMIT_MAX_BURST=5
LOGIN_RATELIMIT_SECONDS=60
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_RATELIMIT_SECONDS=60

# HARDENED: strong admin token (change before use)
ADMIN_TOKEN=Str0ngAdm!nT0ken_changeme

# HARDENED: short session lifetime (30 minutes)
SESSION_JWT_EXPIRATION=30

WEBSOCKET_ENABLED=true
LOG_LEVEL=warn
